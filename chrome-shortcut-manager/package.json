{
  "name": "chrome-manager-upmedia",
  "version": "1.9.0",
  "description": "Chrome Manager by UP Media — Quản lý Chrome profile và tạo shortcut Desktop cho Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/upmedia0108/chrome-manager-upmedia"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sql.js": "^1.10.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.upmedia.chromemanager",
    "productName": "Chrome Manager by UP Media",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/xlsx/**/*",
      "node_modules/argparse/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "upmedia0108",
        "repo": "chrome-manager-upmedia",
        "releaseType": "release"
      }
    ]
  }
}
